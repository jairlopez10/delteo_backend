# Plantilla de configuracion. Copiar a .env y rellenar con valores reales.
# NUNCA poner valores reales en este archivo: si se versiona.

# --- Google Sheets ---
# JSON del service account codificado en base64 (una sola linea).
# Generar con:  node -e "console.log(require('fs').readFileSync('secrets.json').toString('base64'))"
GOOGLE_CREDENTIALS_BASE64=
# Alternativa antigua: ruta a un archivo JSON en disco. Solo se usa si no hay base64.
GOOGLE_APPLICATION_CREDENTIALS=
SHEET_ID=
SHEET_ID_ORDERDETAILD=

# --- Servidor ---
FRONTEND_URL=http://localhost:5173
PORT=4009

# --- Wompi ---
# sandbox | production
WOMPI_ENV=sandbox
# Sandbox: pub_test_... / Produccion: pub_prod_...
WOMPI_PUBLIC_KEY=
# Sandbox: prv_test_... / Produccion: prv_prod_...   NUNCA exponer al frontend
WOMPI_PRIVATE_KEY=
# Sandbox: test_integrity_... / Produccion: prod_integrity_...   NUNCA exponer al frontend
WOMPI_INTEGRITY_SECRET=
# Sandbox: test_events_... / Produccion: prod_events_...   NUNCA exponer al frontend
WOMPI_EVENTS_SECRET=
